{
  "name": "clinical-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Post-discharge follow-up AI voice agent: config-driven call scripts, rule-based escalation, transport-agnostic orchestrator, eval harness. SYNTHETIC DATA ONLY.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "dev": "tsx watch src/server/app.ts",
    "start": "node dist/server/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "eval": "tsx src/eval/runEvals.ts",
    "eval:mock": "tsx src/eval/runEvals.ts --mock",
    "scenarios:gen": "node scripts/generateScenarios.mjs",
    "demo:call": "tsx src/scripts/demo.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{md,json,yaml,yml}\""
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.2.0",
    "twilio": "^5.4.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.0"
  }
}
