# ---------------------------------------------------------------------------
# SYNTHETIC DATA ONLY — this project never handles real PHI.
# Copy to .env and fill in. .env is gitignored; never commit secrets.
# ---------------------------------------------------------------------------

# --- REQUIRED: missing any of these -> the app exits(1) at boot listing what is missing ---
DATABASE_URL=postgres://postgres:***@localhost:5432/clinical_voice
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=
# omlx enforces an API key. It is the value of `auth.api_key` in ~/.omlx/settings.json
# of the machine running omlx. No sane default on purpose -> fail fast with a hint.
LLM_API_KEY=

# --- OPTIONAL with defaults ---
JUDGE_BASE_URL=
JUDGE_MODEL=
PRACTICE_NAME=Sunrise Medical Group
LOG_LEVEL=info

# --- OPTIONAL_PARTIAL: all absent -> boot in text-only mode (STT/TTS/telephony stubbed).
#     A partial set (some present, not all) is a hard error naming the missing keys,
#     because silently broken voice is worse than honest text-only mode. ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_HOST=

# --- OPTIONAL: mode switches ---
# MOCK_LLM=true replaces the local model with a scripted stand-in so the whole pipeline
# (server, evals, demo) runs with no GPU and no cloud keys. Mock numbers are plumbing
# checks, never model-quality results.
MOCK_LLM=false
# Optional webhook notified on every escalation (best-effort; the DB row is the record).
ESCALATION_WEBHOOK_URL=
# Staff number used for warm transfers (Twilio <Dial>).
ESCALATION_STAFF_NUMBER=
